GEMINI_API_KEY=

# Demo Ganache blockchain (never sent from the browser - server-side only)
GANACHE_RPC_URL=http://127.0.0.1:7545
GANACHE_PRIVATE_KEY=
AUDIT_CONTRACT_ADDRESS=
AUDIT_CONTRACT_ABI_PATH=blockchain/AuditTrail.abi.json
